---
import Layout from './Layout.astro';
import SeeAlso from '../components/SeeAlso.astro';
import Backlinks from '../components/Backlinks.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import Infobox from '../components/Infobox.astro';

interface Props {
  title: string;
  kahu_tok?: string;
  status?: string;
  summary?: string;
  meta?: { label: string; value: string }[];
  contested_traditions?: string[];
  open_canon?: string[];
  collection: string;
  slug: string;
}

const COLLECTION_LABELS: Record<string, string> = {
  people: 'people',
  places: 'places',
  events: 'events',
  eras: 'eras',
  concepts: 'concepts',
  organizations: 'organizations',
  objects: 'objects',
  language: 'language',
};

const {
  title,
  kahu_tok,
  status,
  summary,
  meta = [],
  contested_traditions = [],
  open_canon = [],
  collection,
  slug,
} = Astro.props;
const categoryLabel = COLLECTION_LABELS[collection] ?? collection;

// the infobox shows status as a badge and summary as its own block,
// so drop those labels from the meta rows to avoid duplication in the
// right rail. The inline dl (mobile) keeps them.
const dedupeInfoboxMeta = (rows: { label: string; value: string }[]) => {
  const drop = new Set<string>();
  if (status) drop.add('status');
  if (summary) drop.add('definition'); // language entries: definition is the summary
  return drop.size === 0 ? rows : rows.filter((m) => !drop.has(m.label.toLowerCase()));
};
const infoboxMeta = dedupeInfoboxMeta(meta);
---

<Layout title={title}>
  <Infobox
    slot="right-rail"
    title={title}
    kahu_tok={kahu_tok}
    collection={collection}
    status={status}
    summary={summary}
    meta={infoboxMeta}
    open_canon={open_canon}
  />

  <article class="entry">
    <nav class="entry-breadcrumb" aria-label="breadcrumb">
      <a href="/">archive</a>
      <span class="entry-breadcrumb-sep">/</span>
      <a href={`/${collection}`}>{categoryLabel}</a>
      <span class="entry-breadcrumb-sep">/</span>
      <span class="entry-breadcrumb-current">{title}</span>
    </nav>

    <header class="entry-header">
      <h1>{title}</h1>
      {kahu_tok && <p class="entry-kahu-tok"><span class="kt">{kahu_tok}</span></p>}
    </header>

    {meta.length > 0 && (
      <dl class="entry-meta entry-meta--inline">
        {meta.map((m) => (
          <div class="entry-meta-row">
            <dt>{m.label}</dt>
            <dd set:html={m.value} />
          </div>
        ))}
      </dl>
    )}

    <div class="entry-body">
      <slot />
    </div>

    {contested_traditions.length > 0 && (
      <aside class="entry-contested">
        <h2>contested traditions</h2>
        {contested_traditions.map((t) => <p>{t}</p>)}
      </aside>
    )}

    {open_canon.length > 0 && (
      <aside class="entry-open-canon">
        <h2>open canon</h2>
        <p>the following questions are not yet settled in the record:</p>
        <ul>
          {open_canon.map((q) => <li>{q}</li>)}
        </ul>
      </aside>
    )}

    <SeeAlso collection={collection} slug={slug} />

    <Backlinks collection={collection} slug={slug} />
  </article>

  <CategoryStrip current={collection} />
</Layout>
