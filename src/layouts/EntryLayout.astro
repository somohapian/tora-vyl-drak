---
import Layout from './Layout.astro';
import SeeAlso from '../components/SeeAlso.astro';
import CategoryStrip from '../components/CategoryStrip.astro';

interface Props {
  title: string;
  kahu_tok?: string;
  meta?: { label: string; value: string }[];
  open_canon?: string[];
  collection: string;
  slug: string;
}

const COLLECTION_LABELS: Record<string, string> = {
  people: 'people',
  places: 'places',
  events: 'events',
  eras: 'eras',
  concepts: 'concepts',
  organizations: 'organizations',
  objects: 'objects',
  language: 'language',
};

const { title, kahu_tok, meta = [], open_canon = [], collection, slug } = Astro.props;
const categoryLabel = COLLECTION_LABELS[collection] ?? collection;
---

<Layout title={title}>
  <article class="entry">
    <nav class="entry-breadcrumb" aria-label="breadcrumb">
      <a href="/">archive</a>
      <span class="entry-breadcrumb-sep">/</span>
      <a href={`/${collection}`}>{categoryLabel}</a>
      <span class="entry-breadcrumb-sep">/</span>
      <span class="entry-breadcrumb-current">{title}</span>
    </nav>

    <header class="entry-header">
      <h1>{title}</h1>
      {kahu_tok && <p class="entry-kahu-tok"><span class="kt">{kahu_tok}</span></p>}
    </header>

    {meta.length > 0 && (
      <dl class="entry-meta">
        {meta.map((m) => (
          <div class="entry-meta-row">
            <dt>{m.label}</dt>
            <dd set:html={m.value} />
          </div>
        ))}
      </dl>
    )}

    <div class="entry-body">
      <slot />
    </div>

    {open_canon.length > 0 && (
      <aside class="entry-open-canon">
        <h2>open canon</h2>
        <p>the following questions are not yet settled in the record:</p>
        <ul>
          {open_canon.map((q) => <li>{q}</li>)}
        </ul>
      </aside>
    )}

    <SeeAlso collection={collection} slug={slug} />
  </article>

  <CategoryStrip current={collection} />
</Layout>
