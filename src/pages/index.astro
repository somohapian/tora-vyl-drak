---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const CATEGORIES = [
  { slug: 'people', label: 'people', blurb: 'founders, figures, the named' },
  { slug: 'places', label: 'places', blurb: 'the caldera and the world below' },
  { slug: 'events', label: 'events', blurb: 'the fracture, the leveling, the schism' },
  { slug: 'eras', label: 'eras', blurb: 'tapestry, bloom, endura' },
  { slug: 'concepts', label: 'concepts', blurb: 'peli-shen, warden, the cascade' },
  { slug: 'organizations', label: 'organizations', blurb: 'zou-esh, the council, the tenders' },
  { slug: 'objects', label: 'objects', blurb: 'the zou-kit and beyond' },
  { slug: 'language', label: 'language', blurb: 'kahu-tok and the bixel 1000' },
] as const;

const RECENT_SLUGS: Array<[string, string]> = [
  ['places', 'the-hearth'],
  ['places', 'the-wilds'],
  ['eras', 'age-of-tapestry'],
  ['eras', 'the-dark-century'],
  ['concepts', 'the-creeping-dark'],
  ['concepts', 'the-five-filters-of-uniqueness'],
  ['events', 'the-first-descent'],
  ['organizations', 'the-council'],
  ['people', 'the-longs'],
];

const collections = await Promise.all(
  CATEGORIES.map((c) => getCollection(c.slug)),
);

const flat = collections.flat();
const lookup = new Map(flat.map((e) => [`${e.collection}/${e.slug}`, e]));

const portals = CATEGORIES.map((c, i) => ({
  ...c,
  count: collections[i].length,
}));

const recent = RECENT_SLUGS
  .map(([col, slug]) => lookup.get(`${col}/${slug}`))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .map((e) => ({
    collection: e.collection,
    slug: e.slug,
    name: 'name' in e.data ? e.data.name : (e.data as { word: string }).word,
    kahu_tok: 'kahu_tok' in e.data ? e.data.kahu_tok : undefined,
    summary: 'summary' in e.data ? e.data.summary : (e.data as { definition?: string }).definition ?? '',
  }));

// Featured entry: pick the most-recently-added entry (first of RECENT_SLUGS),
// which gives us a deterministic, rotating-with-content choice.
const featured = recent[0];
---

<Layout>
  <section class="wiki-hero">
    <h1 class="wiki-hero-title">
      <span class="proper">tora vyl drak</span>
    </h1>
    <p class="wiki-hero-subtitle">
      the kahu vyl encyclopedia — a hand-written archive of a sanctuary inside a caldera, twenty-five centuries after the sky fell.
    </p>
    <hr class="kahu-rule" />
  </section>

  {featured && (
    <section class="wiki-featured" aria-labelledby="featured-heading">
      <p class="wiki-section-eyebrow" id="featured-heading">featured entry</p>
      <a class="wiki-featured-card" href={`/${featured.collection}/${featured.slug}`}>
        <div class="wiki-featured-head">
          <span class="wiki-featured-name">{featured.name}</span>
          {featured.kahu_tok && <span class="kt wiki-featured-kt">{featured.kahu_tok}</span>}
          <span class="wiki-featured-category">{featured.collection}</span>
        </div>
        {featured.summary && <p class="wiki-featured-summary">{featured.summary}</p>}
        <span class="wiki-featured-cta">read the entry →</span>
      </a>
    </section>
  )}

  <section class="wiki-portals" aria-labelledby="portals-heading">
    <p class="wiki-section-eyebrow" id="portals-heading">explore by category</p>
    <div class="wiki-portal-grid">
      {portals.map((p) => (
        <a class={`wiki-portal-card portal-${p.slug}`} href={`/${p.slug}`}>
          <span class="wiki-portal-swatch" aria-hidden="true"></span>
          <span class="wiki-portal-label">{p.label}</span>
          <span class="wiki-portal-blurb">{p.blurb}</span>
          <span class="wiki-portal-count">
            {p.count} {p.count === 1 ? 'entry' : 'entries'}
          </span>
        </a>
      ))}
    </div>
  </section>

  <aside class="wiki-wander" aria-labelledby="wander-heading">
    <p class="wiki-section-eyebrow" id="wander-heading">how to wander this wiki</p>
    <p>
      the left rail lists every entry by category — open a group to skim its members. inside an entry, hover any in-text link to peek at where it leads, and check <em>mentioned by</em> at the foot of the page to follow the thread backwards. the underlined ember marks proper nouns, and <span class="kt">monospaced italic</span> marks <span class="kt">kahu-tok</span>.
    </p>
  </aside>

  {recent.length > 0 && (
    <footer class="wiki-recent-footer" aria-labelledby="recent-heading">
      <p class="wiki-section-eyebrow" id="recent-heading">recently added</p>
      <ul class="wiki-recent-list">
        {recent.map((r) => (
          <li>
            <a href={`/${r.collection}/${r.slug}`}>
              <span class="wiki-recent-name">{r.name}</span>
              <span class="wiki-recent-collection">{r.collection}</span>
            </a>
          </li>
        ))}
      </ul>
    </footer>
  )}
</Layout>

<style>
  .wiki-hero {
    margin-top: 1rem;
  }
  .wiki-hero-title {
    font-family: var(--serif-display);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 500;
    margin: 0;
    line-height: 1.05;
  }
  .wiki-hero-subtitle {
    font-family: var(--serif-body);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: var(--measure);
    margin: 0.75rem 0 0;
  }

  .wiki-section-eyebrow {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ash);
    margin: 0 0 0.75rem;
  }

  /* ----- featured entry ----- */
  .wiki-featured {
    margin: 2.5rem 0 0;
  }
  .wiki-featured-card {
    display: block;
    padding: 1.4rem 1.5rem 1.25rem;
    background: var(--parchment);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--ember);
    text-decoration: none;
    color: var(--ink);
    transition: background 160ms ease, border-color 160ms ease;
  }
  .wiki-featured-card:hover {
    background: var(--parchment-deep);
  }
  .wiki-featured-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
  }
  .wiki-featured-name {
    font-family: var(--serif-display);
    font-size: 1.5rem;
    font-weight: 500;
    text-transform: lowercase;
  }
  .wiki-featured-kt {
    font-size: 0.9rem;
  }
  .wiki-featured-category {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ash);
  }
  .wiki-featured-summary {
    font-family: var(--serif-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0.75rem 0 0;
    max-width: var(--measure);
  }
  .wiki-featured-cta {
    display: inline-block;
    margin-top: 0.85rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ember);
  }

  /* ----- category portals ----- */
  .wiki-portals {
    margin: 2.5rem 0 0;
  }
  .wiki-portal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .wiki-portal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.1rem 1rem 1.6rem;
    background: var(--parchment);
    text-decoration: none;
    color: var(--ink);
    transition: background 160ms ease;
  }
  .wiki-portal-card:hover {
    background: var(--parchment-deep);
  }
  .wiki-portal-swatch {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 6px;
    background: var(--ash);
  }
  /* category-typed swatch colors — solid blocks, no images. */
  .portal-people .wiki-portal-swatch       { background: #8a6a3a; }
  .portal-places .wiki-portal-swatch       { background: #4a6a55; }
  .portal-events .wiki-portal-swatch       { background: #a75a3a; }
  .portal-eras .wiki-portal-swatch         { background: #7a5a8a; }
  .portal-concepts .wiki-portal-swatch     { background: #5a6a8a; }
  .portal-organizations .wiki-portal-swatch { background: #6a5a45; }
  .portal-objects .wiki-portal-swatch      { background: #8a7a4a; }
  .portal-language .wiki-portal-swatch     { background: #4a5a6a; }

  .wiki-portal-label {
    font-family: var(--serif-display);
    font-size: 1.15rem;
    font-weight: 500;
    text-transform: lowercase;
  }
  .wiki-portal-blurb {
    font-family: var(--serif-body);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .wiki-portal-count {
    margin-top: 0.25rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ash);
  }

  /* ----- wander callout ----- */
  .wiki-wander {
    margin: 2.5rem 0 0;
    padding: 1.25rem 1.4rem;
    background: rgba(180, 165, 140, 0.07);
    border-left: 2px solid var(--rule);
  }
  .wiki-wander p {
    font-family: var(--serif-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: var(--measure);
  }

  /* ----- small recently-added footer block ----- */
  .wiki-recent-footer {
    margin: 3rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .wiki-recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .wiki-recent-list li { margin: 0; }
  .wiki-recent-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink-soft);
    padding: 0.15rem 0;
  }
  .wiki-recent-list a:hover {
    color: var(--ember);
  }
  .wiki-recent-name {
    font-family: var(--serif-display);
    font-size: 0.95rem;
    text-transform: lowercase;
  }
  .wiki-recent-collection {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ash);
  }
</style>
