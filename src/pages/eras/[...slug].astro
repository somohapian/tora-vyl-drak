---
import { getCollection } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('eras');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const span = d.year_start && d.year_end ? `${d.year_start} to ${d.year_end}` : (d.year_start || d.year_end || '');
const meta = [
  span && { label: 'span', value: span },
].filter(Boolean) as { label: string; value: string }[];
---

<EntryLayout
  title={d.name}
  kahu_tok={d.kahu_tok}
  summary={d.summary}
  meta={meta}
  contested_traditions={d.contested_traditions}
  open_canon={d.open_canon}
  collection="eras"
  slug={entry.slug}
>
  <Content />
</EntryLayout>
