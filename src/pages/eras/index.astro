---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = await getCollection('eras');
entries.sort((a, b) => (a.data.year_start || '').localeCompare(b.data.year_start || ''));
---

<Layout title="eras">
  <h1>eras</h1>
  <p class="lede">tapestry, bloom, endura.</p>
  <hr class="kahu-rule" />
  <ul class="entry-list">
    {entries.map((entry) => (
      <li>
        <a href={`/eras/${entry.slug}`}>
          <span class="entry-list-name">{entry.data.name}</span>
          {entry.data.year_start && <span class="entry-list-kt">{entry.data.year_start} - {entry.data.year_end || 'present'}</span>}
          <span class="entry-list-summary">{entry.data.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
