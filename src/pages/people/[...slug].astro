---
import { getCollection } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('people');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const meta = [
  d.role && { label: 'role', value: d.role },
  d.era && { label: 'era', value: d.era },
  d.born && { label: 'born', value: d.born },
  d.died && { label: 'died', value: d.died },
  d.status && { label: 'status', value: d.status },
].filter(Boolean) as { label: string; value: string }[];
---

<EntryLayout
  title={d.name}
  kahu_tok={d.kahu_tok}
  meta={meta}
  open_canon={d.open_canon}
  collection="people"
  slug={entry.slug}
>
  <Content />
</EntryLayout>
