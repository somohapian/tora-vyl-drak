---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = await getCollection('language');
entries.sort((a, b) => a.data.word.localeCompare(b.data.word));
---

<Layout title="language">
  <h1>language</h1>
  <p class="lede">kahu-tok and the bixel 1000.</p>
  <p class="lang-index-feature"><a href="/language/mil-tok">the mil-tok</a>: the master lexicon, the thousand words as bixel set them down.</p>
  <p class="lang-index-feature"><a href="/dictionary">the tok-kahu</a>: the archive's dictionary, every word of the language as its own entry.</p>
  <hr class="kahu-rule" />
  <ul class="entry-list">
    {entries.map((entry) => (
      <li>
        <a href={`/language/${entry.slug}`}>
          <span class="entry-list-name kt">{entry.data.word}</span>
          <span class="entry-list-kt">{entry.data.definition}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
