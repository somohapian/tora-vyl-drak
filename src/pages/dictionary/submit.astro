---
import Layout from '../../layouts/Layout.astro';

// offer a word: the public gate of the tok-kahu. the form posts to the desk
// (the archive's own machine) and the offering travels onward from there;
// no address appears anywhere on this page, by jay's ruling. the archive
// answers with tru-tenk (thank you; truly thanks), lexicon.mjs entry of 4625.
// nothing enters the record without review.
---

<Layout
  title="offer a word"
  description="offer a word to the tok-kahu: the word, the year, and its meaning. the archive reads every offering before anything enters the record."
>
  <article class="entry-body offer-word">
    <nav class="entry-breadcrumb" aria-label="breadcrumb">
      <a href="/">archive</a>
      <span class="entry-breadcrumb-sep">/</span>
      <a href="/dictionary">dictionary</a>
      <span class="entry-breadcrumb-sep">/</span>
      <span class="entry-breadcrumb-current">offer a word</span>
    </nav>

    <h1>offer a word</h1>
    <p class="lede">a language grows at its edges. if you hold a word the record does not, offer it here: the word, the year you place it in, and what it means. no name is asked and none is kept; the archive reads every offering, and nothing enters the record unreviewed.</p>
    <hr class="kahu-rule" />

    <form class="offer-form" data-offer-form novalidate>
      <label>
        <span class="offer-label">the word</span>
        <input type="text" name="word" required autocomplete="off" spellcheck="false" data-offer-word />
      </label>

      <label>
        <span class="offer-label">the year (any reckoning: ad, or the kahu count)</span>
        <input type="text" name="year" required autocomplete="off" data-offer-year />
      </label>

      <label>
        <span class="offer-label">what it is, and its meaning</span>
        <textarea name="meaning" rows="7" required data-offer-meaning></textarea>
      </label>

      <p class="offer-web" aria-hidden="true">
        <label>leave this empty <input type="text" name="web" tabindex="-1" autocomplete="off" data-offer-web /></label>
      </p>

      <button type="submit" class="offer-send" data-offer-send>send to the archive</button>

      <p class="offer-missing" data-offer-missing hidden>the archive needs all three: the word, the year, and its meaning.</p>
      <p class="offer-fail" data-offer-fail hidden>the gate is closed just now. the archive is not always awake; keep the word and try again in a little while.</p>
    </form>

    <p class="offer-tenk" data-offer-tenk hidden><span class="kt">tru-tenk</span>. the offering is with the archive now. if the word enters the record, the <a class="wiki-link" href="/dictionary">tok-kahu</a> will hold it.</p>
  </article>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-offer-form]');
  const word = document.querySelector<HTMLInputElement>('[data-offer-word]');
  const year = document.querySelector<HTMLInputElement>('[data-offer-year]');
  const meaning = document.querySelector<HTMLTextAreaElement>('[data-offer-meaning]');
  const web = document.querySelector<HTMLInputElement>('[data-offer-web]');
  const send = document.querySelector<HTMLButtonElement>('[data-offer-send]');
  const missing = document.querySelector<HTMLElement>('[data-offer-missing]');
  const fail = document.querySelector<HTMLElement>('[data-offer-fail]');
  const tenk = document.querySelector<HTMLElement>('[data-offer-tenk]');

  if (form && word && year && meaning && send) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const w = word.value.trim();
      const y = year.value.trim();
      const m = meaning.value.trim();
      if (missing) missing.hidden = true;
      if (fail) fail.hidden = true;
      if (!w || !y || !m) {
        if (missing) missing.hidden = false;
        return;
      }
      send.disabled = true;
      send.textContent = 'carrying it in…';
      try {
        const r = await fetch('https://desk.somohapian.com/offer', {
          method: 'POST',
          body: new URLSearchParams({ word: w, year: y, meaning: m, web: web ? web.value : '' }),
        });
        if (r.ok) {
          form.hidden = true;
          if (tenk) tenk.hidden = false;
          return;
        }
        if (r.status === 400 && missing) {
          missing.hidden = false;
        } else if (fail) {
          fail.hidden = false;
        }
      } catch {
        if (fail) fail.hidden = false;
      }
      send.disabled = false;
      send.textContent = 'send to the archive';
    });
  }
</script>

<style>
  .offer-word {
    max-width: 44rem;
  }
  .offer-word h1 {
    font-family: var(--serif-display);
    font-weight: 500;
  }
  .offer-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.4rem;
  }
  .offer-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .offer-label {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .offer-form input,
  .offer-form textarea {
    background: var(--paper-deeper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--serif-body);
    font-size: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 3px;
  }
  .offer-form textarea {
    resize: vertical;
    line-height: 1.55;
  }
  .offer-form input:focus,
  .offer-form textarea:focus {
    outline: none;
    border-color: var(--ember);
  }
  .offer-web {
    position: absolute;
    left: -9999px;
    height: 1px;
    overflow: hidden;
  }
  .offer-send {
    align-self: flex-start;
    background: var(--paper-deeper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--serif-display);
    font-size: 1rem;
    padding: 0.5rem 1.1rem;
    border-radius: 3px;
    cursor: pointer;
  }
  .offer-send:hover {
    border-color: var(--ember);
    color: var(--ember-deep);
  }
  .offer-send:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .offer-missing,
  .offer-fail {
    color: var(--ember-deep);
    font-size: 0.95rem;
    margin: 0;
  }
  .offer-tenk {
    margin-top: 1.6rem;
    font-size: 1.05rem;
  }
  .offer-tenk .kt {
    font-size: 1.15rem;
  }
</style>
