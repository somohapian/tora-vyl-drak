---
import Layout from '../../layouts/Layout.astro';

// offer a word: the public gate of the tok-kahu. the form composes a mail to
// the archive keeper (jay@somohapian.com); nothing enters the record without
// review, and new coinages wait on jay's confirm, per the standing doctrine.
---

<Layout
  title="offer a word"
  description="offer a word to the tok-kahu: the word, the year, and its meaning. the archive reads every offering before anything enters the record."
>
  <article class="entry-body offer-word">
    <nav class="entry-breadcrumb" aria-label="breadcrumb">
      <a href="/">archive</a>
      <span class="entry-breadcrumb-sep">/</span>
      <a href="/dictionary">dictionary</a>
      <span class="entry-breadcrumb-sep">/</span>
      <span class="entry-breadcrumb-current">offer a word</span>
    </nav>

    <h1>offer a word</h1>
    <p class="lede">a language grows at its edges. if you hold a word the record does not, offer it here: the word, the year you place it in, and what it means. the archive reads every offering; nothing enters the record unreviewed.</p>
    <hr class="kahu-rule" />

    <form class="offer-form" data-offer-form novalidate>
      <label>
        <span class="offer-label">the word</span>
        <input type="text" name="word" required autocomplete="off" spellcheck="false" data-offer-word />
      </label>

      <label>
        <span class="offer-label">the year (any reckoning: ad, or the kahu count)</span>
        <input type="text" name="year" required autocomplete="off" data-offer-year />
      </label>

      <label>
        <span class="offer-label">what it is, and its meaning</span>
        <textarea name="meaning" rows="7" required data-offer-meaning></textarea>
      </label>

      <button type="submit" class="offer-send">send to the archive</button>

      <p class="offer-note">the form opens your own mail, addressed to the archive, so the archive can answer you. or write directly: <a class="wiki-link" href="mailto:jay@somohapian.com">jay@somohapian.com</a>.</p>
      <p class="offer-missing" data-offer-missing hidden>the archive needs all three: the word, the year, and its meaning.</p>
      <p class="offer-sent" data-offer-sent hidden>your mail is opening. send it, and the offering is with the archive.</p>
    </form>
  </article>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-offer-form]');
  const word = document.querySelector<HTMLInputElement>('[data-offer-word]');
  const year = document.querySelector<HTMLInputElement>('[data-offer-year]');
  const meaning = document.querySelector<HTMLTextAreaElement>('[data-offer-meaning]');
  const missing = document.querySelector<HTMLElement>('[data-offer-missing]');
  const sent = document.querySelector<HTMLElement>('[data-offer-sent]');

  if (form && word && year && meaning) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const w = word.value.trim();
      const y = year.value.trim();
      const m = meaning.value.trim();
      if (!w || !y || !m) {
        if (missing) missing.hidden = false;
        if (sent) sent.hidden = true;
        return;
      }
      if (missing) missing.hidden = true;
      const subject = `a word offered to the tok-kahu: ${w}`;
      const body = [
        `word: ${w}`,
        `year: ${y}`,
        'what it is, and its meaning:',
        m,
        '',
        'offered through somohapian.com/dictionary/submit',
      ].join('\n');
      if (sent) sent.hidden = false;
      window.location.href = `mailto:jay@somohapian.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>

<style>
  .offer-word {
    max-width: 44rem;
  }
  .offer-word h1 {
    font-family: var(--serif-display);
    font-weight: 500;
  }
  .offer-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.4rem;
  }
  .offer-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .offer-label {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .offer-form input,
  .offer-form textarea {
    background: var(--paper-deeper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--serif-body);
    font-size: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 3px;
  }
  .offer-form textarea {
    resize: vertical;
    line-height: 1.55;
  }
  .offer-form input:focus,
  .offer-form textarea:focus {
    outline: none;
    border-color: var(--ember);
  }
  .offer-send {
    align-self: flex-start;
    background: var(--paper-deeper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--serif-display);
    font-size: 1rem;
    padding: 0.5rem 1.1rem;
    border-radius: 3px;
    cursor: pointer;
  }
  .offer-send:hover {
    border-color: var(--ember);
    color: var(--ember-deep);
  }
  .offer-note {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 0.2rem 0 0;
  }
  .offer-missing {
    color: var(--ember-deep);
    font-size: 0.95rem;
    margin: 0;
  }
  .offer-sent {
    color: var(--ink-soft);
    font-style: italic;
    font-size: 0.95rem;
    margin: 0;
  }
</style>
